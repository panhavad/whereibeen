# Copy to .env and fill in. Used by `npm run dev` (VITE_*) and by docker compose.

# Google OAuth 2.0 Web client ID (Google Cloud Console → APIs & Services → Credentials).
# Docker/compose: injected at container start, no rebuild needed.
GOOGLE_CLIENT_ID=
# Local development with `npm run dev`:
VITE_GOOGLE_CLIENT_ID=

# Port the app is published on (http://localhost:8080).
WHEREIBEEN_PORT=8080

# docker-compose.yml (registry + Watchtower auto-update)
WHEREIBEEN_IMAGE=ghcr.io/your-github-user/whereibeen:latest
WATCHTOWER_POLL_INTERVAL=60
TZ=UTC

# docker-compose.selfhost.yml (local build + git auto-update)
AUTO_UPDATE_BRANCH=main
AUTO_UPDATE_INTERVAL=30
AUTO_UPDATE_FETCH=true
